# Supabase Auth — the anon key is public by design and safe to ship in the browser.
# NEVER put a service-role key or any other secret in this file or anywhere in frontend/.
# Leave both blank to run with a fake logged-in demo user instead of real auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend base URL (FastAPI). Leave blank to run fully in demo mode: lawyer matching and every
# other call are mocked locally in frontend/src/lib, no backend required.
VITE_API_URL=

# Backend for the lawyers' Fish Audio voices and lip-sync timing (POST /api/speak), e.g. http://localhost:8000.
# Leave empty to speak with the browser's built-in voice. The backend must allow this app's origin
# (CHAMBERS_CORS_ORIGINS, default http://localhost:5173).
VITE_TTS_API_URL=
