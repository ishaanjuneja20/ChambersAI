{
  "name": "chambersai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-basis-transcoder.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-basis-transcoder.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "render:headshots": "node scripts/render-headshots.mjs",
    "build:avatars:compress": "node scripts/compress-avatars.mjs && node scripts/verify-avatar-glbs.mjs",
    "verify:avatars": "node scripts/verify-avatar-glbs.mjs && node scripts/verify-avatar-geometry.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "meshoptimizer": "^0.18.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
